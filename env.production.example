# Copy into Vercel → alyson-client → Settings → Environment Variables (Production)
# https://alyson-client.vercel.app

RESEND_API_KEY=
RESEND_FROM_EMAIL=Alyson HR <reports@cintara.ai>
DAILY_REPORT_ENABLED=true
DAILY_REPORT_RECIPIENTS=alysonclient@cintara.ai,thirumalai@cintara.ai
DAILY_REPORT_CRON_SECRET=
CRON_SECRET=
# Optional: separate code for Reports → Daily email → Send now (defaults to CRON_SECRET)
DAILY_REPORT_UI_SEND_CODE=
DAILY_REPORT_INCLUDE_HOURLY=false
DAILY_REPORT_INCLUDE_SCORING=true
DAILY_REPORT_INCLUDE_WORKSPACE=true
DAILY_REPORT_INCLUDE_TIME_DOCTOR=true
DAILY_REPORT_HOURS_BACK=24

# Time Doctor OAuth + API: configure in local `.env` only (copy same keys to Vercel Production). See docs/TIME_DOCTOR_OAUTH.md.

# Unified meeting bot schedule state (same bucket as Notetaker — survives Vercel restarts)
# UNIFIED_SCHEDULED_STATE_SOURCE=auto

# Notetaker transcript cron — dumps all transcripts to S3 every 5 min (vercel.json)
NOTETAKER_TRANSCRIPT_CRON_ENABLED=true
NOTETAKER_TRANSCRIPT_CRON_SECRET=
NOTETAKER_AUTO_PERSIST_S3=true
# Transcript cron tuning: only sweep meetings from the last N hours (Recall media expires after
# RECALL_RECORDING_RETENTION_HOURS), stop the per-bot loop after this budget, and cap Recall backfills per run.
# NOTETAKER_CRON_LOOKBACK_HOURS=72
# NOTETAKER_CRON_PERSIST_BUDGET_MS=150000
# NOTETAKER_CRON_MAX_BACKFILLS=25
# Notes go out right after the meeting: Recall bot webhooks (bot.done / transcript.done) trigger notes + email.
# Set false to fall back to the cron sweep only.
# NOTETAKER_NOTES_ON_MEETING_END=true
# Cron fallback: send this long after Recall reports call_ended (instead of waiting 15 min idle)
# NOTETAKER_NOTES_AFTER_END_MS=120000
# Without an end marker: wait until live transcript hash is unchanged for 15 minutes, then generate notes + email
NOTETAKER_NOTES_IDLE_STABLE_MS=900000
# Auto-send meeting notes via SES after notes are ready (set false to generate notes only)
NOTETAKER_NOTES_AUTO_EMAIL=true
# Catch-up if end markers were never written (default 1h idle / meeting age)
# NOTETAKER_NOTES_EMAIL_STALE_FALLBACK_MS=3600000
# Sessions list also backfills S3 in the background (every ~30s when Notetaker UI is open)
# NOTETAKER_SESSIONS_BACKGROUND_SYNC is no longer required — backfill is always on
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# AWS SES — meeting notes email (auto-send after meeting + idle, and manual UI send)
SES_FROM_EMAIL=notetaker@cintara.ai
SES_FROM_NAME=Alyson Notetaker
# Optional override — defaults to AWS_REGION (us-west-2)
# SES_REGION=us-west-2
ALYSON_NOTETAKER_BASE_URL=
VITE_ALYSON_NOTETAKER_BASE_URL=
# Recall transcript webhooks must hit the Notetaker service (not this Vercel app)
PUBLIC_WEBHOOK_BASE_URL=https://api-uic1.onrender.com
RECALL_TRANSCRIPT_WEBHOOK_URL=https://api-uic1.onrender.com/webhooks/recall/transcript
TRANSCRIPT_LANGUAGE=en

# Recall Calendar V2 — auto-schedule bots from Google Calendar webhooks
RECALL_API_KEY=
# Keep Recall recording media 2 days (48h) — inside free ~7d window; Alyson still copies to S3
RECALL_RECORDING_RETENTION_HOURS=48
RECALL_BASE_URL=https://ap-northeast-1.recall.ai
RECALL_CALENDAR_ID=
RECALL_CALENDAR_OAUTH_REDIRECT_URI=https://alyson-client.vercel.app/api/recall/calendar/callback
RECALL_CALENDAR_WEBHOOK_SECRET=
# Option B (recommended, Dec 2025+ accounts): workspace secret — same var verifies calendar + transcript webhooks
RECALL_VERIFICATION_SECRET=
# Who may click "Connect Google Calendar" and get Alyson auto-attached (default: GOOGLE_WORKSPACE_DOMAIN; "*" = anyone)
# RECALL_CALENDAR_CONNECT_DOMAINS=cintara.ai
RECALL_CALENDAR_AUTO_SCHEDULE_EMAILS=alysonclient@cintara.ai,notetaker@cintara.ai,mohita@cintara.ai,thirumalai@cintara.ai,vinit@cintara.ai
ALYSON_APP_BASE_URL=https://alyson-client.vercel.app
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Bonus & shares ledger (same bucket as onboarding — s3://alyson-hr-orgchart/bonus/)
# ALYSON_HR_BONUS_S3_KEY=bonus/data.json
# ALYSON_HR_BONUS_LOG_S3_KEY=bonus/operations.log.jsonl

# Plus all Google DWD + Clerk + Supabase vars from your local .env
